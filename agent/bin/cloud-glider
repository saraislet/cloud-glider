#!/usr/bin/env python3
"""Cloud Glider executable entry point."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from cloud_glider.agent import Agent, AgentConfig  # noqa: E402
from cloud_glider.aws_sdk import AwsSdkGateway  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True)
    args = parser.parse_args()
    config = AgentConfig.load(args.config)
    gateway = AwsSdkGateway(config)
    try:
        return Agent(config, gateway).run()
    finally:
        gateway.close()


if __name__ == "__main__":
    raise SystemExit(main())
