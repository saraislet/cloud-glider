    "EmergencyHoldFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "cloud-glider-${Environment}-emergency-hold"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "set-hold-and-record-terminal-error",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadActiveHold",
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "StateTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "dynamodb:LeadingKeys": [
                        "HOLD"
                      ]
                    }
                  }
                },
                {
                  "Sid": "CreateHoldAndAuditRecord",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:ConditionCheckItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "StateTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "HOLD",
                        "AUDIT#PROPAGATION"
                      ]
                    }
                  }
                },
                {
                  "Sid": "RecordGenerationError",
                  "Effect": "Allow",
                  "Action": "dynamodb:UpdateItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "StateTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "GEN#*"
                      ]
                    }
                  }
                },
                {
                  "Sid": "WriteFunctionLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/cloud-glider-${Environment}-emergency-hold:log-stream:*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "cloud-glider"
          },
          {
            "Key": "environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "purpose",
            "Value": "terminal-error-handler"
          }
        ]
      }
    }
  },
  "Conditions": {
    "ReserveEmergencyHoldConcurrency": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "EmergencyHoldReservedConcurrency"
            },
            -1
          ]
        }
      ]
    }
  }
