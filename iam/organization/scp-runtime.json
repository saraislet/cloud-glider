{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRuntimeActionsOutsideCeiling",
      "Effect": "Deny",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-agent",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-generation-cfn",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-emergency-hold",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-bootstrap-BootstrapRole-*"
          ]
        }
      },
      "NotAction": [
        "cloudformation:CreateStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:DeleteStack",
        "cloudformation:DeleteChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:Describe*",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:ConditionCheckItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeStream",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:ListStreams",
        "ec2:Describe*",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:CreateTags",
        "iam:PassRole",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionAttributes",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:ListBucket",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "cloudwatch:PutMetricData",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "servicequotas:GetServiceQuota",
        "servicequotas:ListServiceQuotas",
        "lambda:InvokeFunction",
        "sns:Publish"
      ]
    },
    {
      "Sid": "DenyRuntimeOutsideRegion",
      "Effect": "Deny",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-agent",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-generation-cfn",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-emergency-hold",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-bootstrap-BootstrapRole-*"
          ]
        },
        "StringNotEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      },
      "NotAction": "iam:PassRole"
    },
    {
      "Sid": "DenyDirectComputeOutsideGenerationRole",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-agent",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-emergency-hold",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-bootstrap-BootstrapRole-*"
          ]
        }
      }
    },
    {
      "Sid": "DenyHoldRolePassRole",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-emergency-hold"
        }
      }
    },
    {
      "Sid": "DenyWrongPassedRoleOrchestrators",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-agent",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-bootstrap-BootstrapRole-*"
          ]
        }
      },
      "NotResource": "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-generation-cfn"
    },
    {
      "Sid": "DenyWrongPassedServiceOrchestrators",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-agent",
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-bootstrap-BootstrapRole-*"
          ]
        },
        "StringNotEqualsIfExists": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyWrongPassedRoleGeneration",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-generation-cfn"
          ]
        }
      },
      "NotResource": "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-agent"
    },
    {
      "Sid": "DenyWrongPassedServiceGeneration",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::${AccountId}:role/cloud-glider-${Environment}-generation-cfn"
          ]
        },
        "StringNotEqualsIfExists": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
