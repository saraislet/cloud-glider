#!/usr/bin/env python3
"""Cloud Glider executable entry point."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from cloud_glider.daemon import Daemon, DaemonConfig  # noqa: E402
from cloud_glider.aws_sdk import AwsSdkGateway  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True)
    args = parser.parse_args()
    backend = json.loads(Path(args.config).read_text()).get(
        "propagation_backend", "cloudformation"
    )
    if backend == "ec2":
        from cloud_glider.ec2_daemon import Ec2Daemon, Ec2DaemonConfig
        from cloud_glider.ec2_sdk import Ec2SdkGateway

        config = Ec2DaemonConfig.load(args.config)
        gateway = Ec2SdkGateway(config)
        daemon_type = Ec2Daemon
    elif backend == "cloudformation":
        config = DaemonConfig.load(args.config)
        gateway = AwsSdkGateway(config)
        daemon_type = Daemon
    else:
        raise ValueError("unknown propagation backend")
    try:
        return daemon_type(config, gateway).run()
    finally:
        gateway.close()


if __name__ == "__main__":
    raise SystemExit(main())
